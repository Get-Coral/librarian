# Server
HOST=0.0.0.0
PORT=3000

# Jellyfin connection
# JELLYFIN_USER_ID must be the user's UUID, not their username.
# The API key alone is enough to browse; username + password additionally open a
# real playback session so watch progress syncs back to Jellyfin.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# SQLite state
LIBRARIAN_DATA_DIR=/data

# Access control
# Librarian defaults to requiring a Jellyfin sign-in, unlike the read-only
# Coral modules — it can move and delete files. Setting this pins the value
# and removes the toggle from the UI.
LIBRARIAN_REQUIRE_LOGIN=true

# Filesystem roots
# These only *seed* rows. A seeded root arrives switched off; a human enables
# it in the UI, because a mounted directory is not permission to write to it.
# Leave unset to add roots by hand instead.
LIBRARIAN_DOWNLOADS_DIR=/library/downloads/complete
LIBRARIAN_MEDIA_DIR=/library/media/movies

# Cross-module access
# An escape hatch for operators who configure everything through compose and
# never open a UI. Grants full access, is never stored, and cannot be revoked
# from the Connections page. Leave unset and issue tokens in the UI instead.
# CORAL_SERVICE_TOKEN=
