# Server
HOST=0.0.0.0
PORT=3000

# Jellyfin connection
# JELLYFIN_USER_ID must be the user's UUID, not their username.
# The API key alone is enough to browse; username + password additionally open a
# real playback session so watch progress syncs back to Jellyfin.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# SQLite state
LIBRARIAN_DATA_DIR=/data
